# OLHOS DE DEUS — Environment Template
# Keep secrets server-side. Never use NEXT_PUBLIC_ for provider keys.

# Original OSIRIS-compatible settings
SCANNER_URL=
SCANNER_KEY=
CLOUDFLARE_API_TOKEN=
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
OSIRIS_PORT=3000

# OLHOS DE DEUS — national intelligence feeds
# NASA FIRMS fire detections
FIRMS_API_KEY=

# OpenSky OAuth client (optional; public access works within provider limits)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Authorized maritime AIS provider
AISSTREAM_API_KEY=

# Satellite tracking provider
N2YO_API_KEY=

# Authorized public camera feed registry
PUBLIC_CAMERA_FEED_URL=

# Governance note:
# Only use public or explicitly authorized sources. Do not add private accounts,
# leaked credentials, unauthorized camera streams, non-public personal data,
# or unauthorized network monitoring.
